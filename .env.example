# AudioBook Wizarrd – example configuration. Copy to .env and adjust.
# Connections (URLs, API keys, libraries, indexers) can also be entered later in the setup wizard
# or under Settings → Connections; values saved there take precedence over this file.

# --- Basics -----------------------------------------------------------------
ABW_TAG=latest                     # image tag
ABW_DATA=./data                    # database, keys, caches
ABW_UID=1000                       # user/group that owns your library and download folders
ABW_GID=1000
TZ=Europe/Berlin

# --- Audiobookshelf (required) ----------------------------------------------
ABS_URL=http://audiobookshelf:80
ABS_PUBLIC_URL=https://audiobookshelf.example.com   # optional, for links in the UI
ABS_API_KEY_HOST_FILE=/path/to/abs_api_key.txt      # file containing the API key
ABS_LIBRARY_EN=                     # library ID for English audiobooks (leave empty if none)
ABS_LIBRARY_DE=                     # library ID for German audiobooks (leave empty if none)

# Folder that contains your library folders (the same files Audiobookshelf sees).
# Libraries and trash live on the same disk, so ABW can move instead of copy.
MUSIC_ROOT_HOST=/path/to/media
LIBRARY_EN_DIR=audiobooks-en        # subfolder for English audiobooks
LIBRARY_DE_DIR=audiobooks-de        # subfolder for German audiobooks
LIBRARY_TRASH_DIR=.abw-trash
ABW_IMPORT_ENABLED=0                # 1 = ABW may place files in the library

# --- Search: Prowlarr --------------------------------------------------------
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY_HOST_FILE=/path/to/prowlarr_api_key.txt
USENET_INDEXER_IDS=                 # e.g. 1,2 – or pick them in the UI
TORRENT_INDEXER_IDS=
EBOOK_TORRENT_INDEXER_IDS=

# --- Downloads: SABnzbd (Usenet) ---------------------------------------------
SABNZBD_URL=http://sabnzbd:8080
SAB_API_KEY_HOST_FILE=/path/to/sab_api_key.txt
SABNZBD_CATEGORY=audiobooks
USENET_COMPLETE_HOST=/path/to/sabnzbd/complete/audiobooks   # finished downloads of that category

# --- Downloads: qBittorrent ---------------------------------------------------
QBIT_URL=http://qbittorrent:8080
QBIT_USERNAME_HOST_FILE=/path/to/qbit_username.txt
QBIT_PASSWORD_HOST_FILE=/path/to/qbit_password.txt
QBIT_SAVE_ROOT=/downloads/.abw-torrents           # path as qBittorrent sees it
TORRENT_COMPLETE_HOST=/path/to/downloads/.abw-torrents   # same folder on the host

# --- Notifications (optional) ------------------------------------------------
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN_HOST_FILE=
ABW_PUBLIC_URL=http://server:8790   # used for links in notifications

# --- Optional extras -----------------------------------------------------------
FLARESOLVERR_URL=                   # Goodreads genres and some extensions
ABW_WHISPER=0                       # 1 = image with speech recognition (much larger)
WHISPER_MODELS_HOST=                # optional cache for the Whisper model
# ABW_PLUGINS_HOST=/path/to/plugins # extensions with additional sources
# ABW_EXTRA_PIP=                    # extra Python packages for extensions
